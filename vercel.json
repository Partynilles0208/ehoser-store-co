{
  "version": 2,
  "builds": [
    {
      "src": "server-supabase.js",
      "use": "@vercel/node",
      "config": { "maxDuration": 60, "includeFiles": ["public/**", "lib/**"] }
    },
    {
      "src": "api/skybreak.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/skybreak",
      "dest": "api/skybreak.js"
    },
    {
      "src": "/api/skybreak/(.*)",
      "dest": "api/skybreak.js"
    },
    {
      "src": "/(.*)",
      "dest": "server-supabase.js"
    }
  ]
}
